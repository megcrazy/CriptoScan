# Telegram Bot API
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Motor de score e liquidez
ALERT_SCORE_MIN=60
SWEEP_VOLUME_MULT=1.5
SWEEP_EXPIRE_BARS=30
FVG_MIN_ATR=0.3
ALERT_TIMEFRAMES=15m,1h,4h
ALERT_STATE_PATH=/opt/cripto/alert_state.json

# Fusion (Titanium Fusion v2.1)
# "sessao" = máxima/mínima da sessão anterior, como o Pine (recomendado).
# "dia"    = adaptação antiga: máxima/mínima do dia UTC anterior.
FUSION_LIQUIDEZ=sessao
# Alinhamento do OI histórico. O Pine mede a variação DENTRO da vela atual, que é
# o que "fechamento" faz. NÃO usar "abertura": ele atrasa o contexto em 1 vela.
FUSION_OI_REF=fechamento
# Idade máxima do C (em velas) para o fib ativo continuar valendo.
FUSION_FIB_IDADE_MAX=93
